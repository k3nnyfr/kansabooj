# Copier en .env (chmod 600) et ne jamais le versionner.
POSTGRES_PASSWORD=changer-moi-avec-un-mot-de-passe-long
# v0.6.1 minimum : la sonde de santé utilise la commande « kansabooj healthcheck »
KANSABOOJ_VERSION=v0.10.0

# Proxy d'entreprise pour les appels sortants (sinon, laisser vide)
# HTTPS_PROXY=http://proxy.interne.example:3128
# NO_PROXY=localhost,127.0.0.1,db

# Secrets référencés dans config/apis.yml
GCHAT_WEBHOOK_PAIEMENT=https://chat.googleapis.com/v1/spaces/…/messages?key=…&token=…
PAYFLOW_CLIENT_SECRET=…
