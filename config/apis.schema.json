{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansabooj.local/apis.schema.json",
  "title": "Kansabooj — configuration des APIs surveillées",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apis"
  ],
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$",
      "description": "Durée Go : 30s, 10m, 6h, 1h30m"
    },
    "ignore": {
      "type": "array",
      "description": "Chemins retirés avant comparaison (anti-bruit). Sous-ensemble JSONPath : $.a.b, * = n'importe quelle clé.",
      "items": {
        "type": "string",
        "pattern": "^\\$\\.[^.]+(\\.[^.]+)*$"
      },
      "examples": [
        [
          "$.servers",
          "$.info.x-generated-at",
          "$.paths.*.x-internal"
        ]
      ]
    },
    "level": {
      "enum": [
        "error",
        "warn",
        "info"
      ]
    },
    "auth": {
      "type": "object",
      "description": "Authentification pour lire la documentation. Les credentials ne sont envoyés qu'à l'origine de source.url.",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "header",
            "query",
            "basic",
            "bearer",
            "oauth2_client_credentials",
            "mtls"
          ]
        },
        "name": {
          "type": "string",
          "description": "header / query : nom de l'en-tête ou du paramètre"
        },
        "value": {
          "type": "string",
          "description": "header / query : valeur (utiliser ${ENV_VAR})"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "token": {
          "type": "string",
          "description": "bearer : token statique"
        },
        "token_url": {
          "type": "string",
          "format": "uri"
        },
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "paramètres additionnels de la requête de token (ex : audience)"
        },
        "cert_file": {
          "type": "string"
        },
        "key_file": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "header",
                  "query"
                ]
              }
            }
          },
          "then": {
            "required": [
              "name",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "basic"
              }
            }
          },
          "then": {
            "required": [
              "username",
              "password"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bearer"
              }
            }
          },
          "then": {
            "required": [
              "token"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "oauth2_client_credentials"
              }
            }
          },
          "then": {
            "required": [
              "token_url",
              "client_id",
              "client_secret"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "mtls"
              }
            }
          },
          "then": {
            "required": [
              "cert_file",
              "key_file"
            ]
          }
        }
      ]
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,49}$",
      "description": "minuscules, chiffres, - _ . :"
    },
    "cidrs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "network": {
      "type": "string",
      "description": "profil réseau (http.profiles) ; défaut : default"
    }
  },
  "properties": {
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "fichiers fragments (globs relatifs à ce fichier) déclarant groups et apis — typiquement un fichier par équipe : apis.d/*.yml"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "description": "Paramètres de la commande serve",
      "properties": {
        "listen": {
          "type": "string",
          "default": ":8080"
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "URL publique de l'interface, utilisée pour les liens dans les notifications"
        },
        "language": {
          "enum": [
            "fr",
            "en"
          ],
          "default": "fr",
          "description": "langue par défaut de l'interface et des notifications"
        },
        "user_header": {
          "type": "string",
          "default": "X-Forwarded-User",
          "description": "en-tête posé par le reverse proxy SSO (acquittements)"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        },
        "check_retention": {
          "$ref": "#/$defs/duration",
          "default": "2160h"
        },
        "require_identity": {
          "type": "boolean",
          "default": false,
          "description": "refuse les appels sans identité SSO ni jeton"
        },
        "admins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "utilisateurs SSO autorisés sur les routes admin (avec require_identity)"
        },
        "tokens": {
          "type": "array",
          "description": "jetons d'API (générer avec « kansabooj token new »)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "hash",
              "scopes"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "scopes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "read",
                    "check",
                    "ack",
                    "validate",
                    "admin"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "description": "Serveur PostgreSQL (tiers, managé, équipe DBA). Ignoré si KANSABOOJ_DB est défini, sauf schema et pool.",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^postgres(ql)?://",
          "description": "URL complète, alternative à host/port/name/user/password"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 5432
        },
        "name": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string",
          "description": "${ENV} ou ${file:...}, jamais en clair"
        },
        "sslmode": {
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ],
          "description": "défaut : verify-full si sslrootcert, sinon require"
        },
        "sslrootcert": {
          "type": "string"
        },
        "sslcert": {
          "type": "string"
        },
        "sslkey": {
          "type": "string"
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$",
          "description": "schéma dédié sur une base partagée"
        },
        "application_name": {
          "type": "string",
          "default": "kansabooj"
        },
        "connect_timeout": {
          "$ref": "#/$defs/duration",
          "default": "10s"
        },
        "max_open_conns": {
          "type": "integer",
          "minimum": 4,
          "default": 10
        },
        "max_idle_conns": {
          "type": "integer",
          "minimum": 0,
          "default": 5
        },
        "conn_max_lifetime": {
          "$ref": "#/$defs/duration",
          "default": "30m"
        },
        "migrate": {
          "type": "boolean",
          "default": true,
          "description": "false : migrations exécutées à part (kansabooj migrate, compte DDL)"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": {
          "$ref": "#/$defs/duration",
          "default": "6h"
        },
        "jitter": {
          "$ref": "#/$defs/duration",
          "default": "5m"
        },
        "timeout": {
          "$ref": "#/$defs/duration",
          "default": "30s"
        },
        "error_threshold": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "échecs consécutifs avant statut stale"
        },
        "notify": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignore": {
          "$ref": "#/$defs/ignore"
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proxy": {
          "type": "string",
          "description": "proxy sortant ; vide = variables HTTPS_PROXY / HTTP_PROXY"
        },
        "ca_bundle": {
          "type": "string",
          "description": "fichier PEM de la CA interne (inspection TLS du proxy)"
        },
        "user_agent": {
          "type": "string"
        },
        "deny_cidrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_body_bytes": {
          "type": "integer",
          "minimum": 1024,
          "default": 20971520
        },
        "allow_cidrs": {
          "$ref": "#/$defs/cidrs",
          "description": "si non vide, seules ces plages sont joignables"
        },
        "profiles": {
          "type": "object",
          "description": "profils réseau nommés (ex. internal : APIs internes sans proxy)",
          "propertyNames": {
            "not": {
              "const": "default"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "proxy": {
                "type": "string",
                "description": "vide = hérite de http.proxy ; none = connexion directe ; sinon URL"
              },
              "ca_bundle": {
                "type": "string"
              },
              "deny_cidrs": {
                "$ref": "#/$defs/cidrs",
                "description": "absent = hérite ; [] = aucune"
              },
              "allow_cidrs": {
                "$ref": "#/$defs/cidrs",
                "description": "si non vide, seules ces plages sont joignables"
              }
            }
          }
        }
      }
    },
    "notifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "googlechat",
              "slack",
              "teams",
              "generic"
            ]
          },
          "url": {
            "type": "string"
          },
          "secret": {
            "type": "string",
            "description": "generic : clé HMAC-SHA256 (en-tête X-Kansabooj-Signature)"
          },
          "min_level": {
            "$ref": "#/$defs/level",
            "default": "warn"
          },
          "only_in_scope": {
            "type": "boolean",
            "default": true
          },
          "language": {
            "enum": [
              "fr",
              "en"
            ],
            "description": "défaut : server.language"
          },
          "subscribe": {
            "type": "object",
            "additionalProperties": false,
            "description": "reçoit aussi les notifications des APIs de ces groupes / portant ces tags",
            "properties": {
              "groups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tags": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/tag"
                }
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "groupes d'APIs portant des valeurs par défaut héritées (API > groupe > defaults)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/tag"
            }
          },
          "interval": {
            "$ref": "#/$defs/duration"
          },
          "timeout": {
            "$ref": "#/$defs/duration"
          },
          "notify": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ignore": {
            "$ref": "#/$defs/ignore"
          },
          "auth": {
            "$ref": "#/$defs/auth"
          },
          "network": {
            "$ref": "#/$defs/network"
          }
        }
      }
    },
    "apis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "description": "clé stable de l'historique : ne jamais renommer"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "description": "équipe propriétaire"
          },
          "group": {
            "type": "string",
            "description": "id d'un groupe déclaré dans groups"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/tag"
            }
          },
          "network": {
            "$ref": "#/$defs/network"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "type": {
                "enum": [
                  "openapi",
                  "swagger-ui",
                  "redoc",
                  "html",
                  "auto"
                ],
                "default": "auto",
                "description": "openapi : URL du fichier de spec ; swagger-ui / redoc : page dont la spec est découverte ; html : texte de la page (mode dégradé) ; auto : spec directe, sinon découverte, sinon html"
              },
              "spec_name": {
                "type": "string",
                "description": "page Swagger-UI déclarant plusieurs specs (urls) : nom de celle à surveiller"
              },
              "text_ignore": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "mode html : expressions régulières retirées du texte (dates, numéros de build…)"
              }
            }
          },
          "auth": {
            "$ref": "#/$defs/auth"
          },
          "interval": {
            "$ref": "#/$defs/duration"
          },
          "timeout": {
            "$ref": "#/$defs/duration"
          },
          "notify": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ignore": {
            "$ref": "#/$defs/ignore"
          },
          "gateway": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exposed_operations": {
                "type": "array",
                "description": "opérations réexposées dans la Gateway ; * final = préfixe ; noms de paramètres ignorés",
                "items": {
                  "type": "string",
                  "pattern": "^(GET|PUT|POST|DELETE|PATCH|HEAD|OPTIONS|TRACE) /\\S*$"
                }
              }
            }
          }
        }
      }
    }
  }
}
